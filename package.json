{
  "name": "drop-player",
  "version": "1.5.11",
  "description": "A comprehensive, universal, open-source React media player powering drop.mov.",
  "keywords": [
    "audio-player",
    "component",
    "hls",
    "image-viewer",
    "media-player",
    "pdf-viewer",
    "player",
    "react",
    "video-player"
  ],
  "homepage": "https://github.com/kumoproductions/drop-player#readme",
  "bugs": {
    "url": "https://github.com/kumoproductions/drop-player/issues"
  },
  "license": "MIT",
  "author": "kumo.productions™",
  "repository": "github:kumoproductions/drop-player",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --config demo/vite.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "postbuild:demo": "node scripts/prerender-demo.mjs",
    "preview:demo": "vite preview --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:llms": "node scripts/generate-llms-txt.mjs",
    "prebuild:demo": "node scripts/generate-llms-txt.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "lefthook install || true",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "hls.js": "^1.6.15",
    "lefthook": "^2.2.2",
    "lucide-react": "^0.577.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0",
    "waveform-data": "^4.5.2"
  },
  "peerDependencies": {
    "hls.js": "^1.4.0",
    "lucide-react": ">=0.300.0",
    "pdfjs-dist": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "waveform-data": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "waveform-data": {
      "optional": true
    }
  },
  "overrides": {
    "@tailwindcss/vite": {
      "vite": "$vite"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.25.0"
}
